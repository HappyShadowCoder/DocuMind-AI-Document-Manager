generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext(schema: "public"), vector]
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  fullName           String?
  role               Role       @default(user)
  passwordHash       String
  storageLimitBytes  BigInt     @default(5368709120)
  mustChangePassword Boolean    @default(false)
  aiProvider         AiProvider @default(ollama)
  openAiApiKey       String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  files              File[]     @relation("UserFiles")
  folders            Folder[]   @relation("UserFolders")
}

model Folder {
  id          String      @id @default(cuid())
  name        String
  parentId    String?
  shared      Boolean     @default(false)
  accessLevel AccessLevel @default(all)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  ownerId     String
  files       File[]
  owner       User        @relation("UserFolders", fields: [ownerId], references: [id], onDelete: Cascade)
  parent      Folder?     @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]    @relation("FolderToFolder")

  @@index([ownerId])
  @@index([parentId])
}

model File {
  id                String           @id @default(cuid())
  name              String
  type              String
  sizeBytes         BigInt
  /// Kept as optional for backward-compat during migration; use blob relation going forward
  path              String?
  shared            Boolean          @default(false)
  accessLevel       AccessLevel      @default(all)
  ownerId           String
  folderId          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  processingStatus  ProcessingStatus @default(idle)
  processingError   String?
  summary           String?
  processedAt       DateTime?
  chunkCount        Int              @default(0)
  embeddingProvider AiProvider?
  isScanned         Boolean          @default(false)
  ocrEngineUsed     String?
  chatMessages      ChatMessage[]
  chunks            DocumentChunk[]
  documentMetadata  DocumentMetadata?
  blob              FileBlob?
  folder            Folder?          @relation(fields: [folderId], references: [id])
  owner             User             @relation("UserFiles", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([folderId])
}

/// Stores raw file bytes separately from File metadata so list queries stay fast
model FileBlob {
  id        String   @id @default(cuid())
  fileId    String   @unique
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model DocumentChunk {
  id         String                @id @default(cuid())
  fileId     String
  chunkIndex Int
  pageNumber Int
  content    String
  tokenCount Int?
  /// Fixed 768-dimension vector column for pgvector storage
  embedding  Unsupported("vector")
  createdAt  DateTime              @default(now())
  file       File                  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([fileId, chunkIndex])
}

model ChatSession {
  id          String          @id @default(cuid())
  entityType  ChatEntityType
  entityId    String
  title       String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    ChatMessage[]

  @@index([entityType, entityId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileId    String?
  content   String
  createdAt DateTime    @default(now())
  role      ChatRole
  sources   String[]    @default([])
  file      File?       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model DocumentMetadata {
  id               String    @id @default(cuid())
  fileId           String    @unique
  file             File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  state            String?
  firNumber        String?
  firDate          DateTime?
  district         String?
  subDivision      String?
  policeStation    String?
  propertyLoss     Float?
  actsAndSections  Json?
  zeroFirReference String?
  rawJson          Json?

  @@index([state])
  @@index([firNumber])
  @@index([district])
  @@index([subDivision])
  @@index([policeStation])
  @@index([firDate])
}

enum Role {
  admin
  user
}

enum AiProvider {
  ollama
  openai
}

enum ProcessingStatus {
  idle
  processing
  ready
  failed
}

enum ChatRole {
  user
  assistant
  system
}

enum ChatEntityType {
  FILE
  FOLDER
  GLOBAL
}

enum AccessLevel {
  all
  admin
}

enum CacheScope {
  FILE
  FOLDER
  GLOBAL
}

model SemanticCache {
  id                String     @id @default(cuid())
  scopeType         CacheScope
  scopeId           String
  docFingerprint    String
  questionHash      String
  /// 768-dimension embedding of the user question (same dim as DocumentChunk)
  questionEmbedding Unsupported("vector")
  answerText        String
  sourcePages       String[]   @default([])
  aiProvider        AiProvider
  hitCount          Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([scopeType, scopeId])
  @@index([docFingerprint])
  @@index([questionHash])
}
